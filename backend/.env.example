# Copy to .env and fill in real values for your environment.
# Never commit the real .env — see .gitignore.

DATABASE_URL=postgresql+asyncpg://hris_app:hris_app_dev_password@localhost:5433/hris
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/hris
APP_DB_ROLE=hris_app

# CHANGE_ME in every environment — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MFA_PENDING_TOKEN_EXPIRE_MINUTES=5

# CHANGE_ME in every environment — generate with:
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Production: source from the org's secrets manager, not this file.
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_URLSAFE_BASE64_KEY

CORS_ALLOW_ORIGINS=["http://localhost:4201"]
