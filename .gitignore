# Backend (Python)
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.env

# Frontend (Node/Angular) — frontend/.gitignore (from `ng new`) covers the rest;
# this repeats the essentials in case files are ever added outside frontend/.
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
